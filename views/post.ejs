<%- include("partials/header"); -%>

<div class="post-page">

  <article class="single-post-card">

```
<!-- Blog Header -->
<div class="post-header">

  <span class="post-badge">📝 Blog Post</span>

  <h1 class="single-post-title"><%= title %></h1>

  <!-- Author -->
  <div class="author-info">

    <div class="author-avatar">
      <%= email.charAt(0).toUpperCase() %>
    </div>

    <div class="author-details">
      <span class="author-label">Written by</span>
      <span class="author-email"><%= email %></span>
    </div>

  </div>

</div>


<!-- Blog Content -->
<div class="single-post-content">
  <p><%= content %></p>
</div>


<!-- Edit / Delete -->
<div class="post-actions">

  <a
    href="/posts/<%= postId %>/edit"
    class="post-action-btn post-edit-btn">
    ✏️ Edit
  </a>

  <form
    action="/posts/<%= postId %>/delete"
    method="POST">

    <button
      type="submit"
      class="post-action-btn post-delete-btn">
      🗑️ Delete
    </button>

  </form>

</div>


<hr class="post-divider">


<!-- AI Chat -->
<div class="ai-section">

  <div class="ai-header">

    <div class="ai-icon">
      🤖
    </div>

    <div>
      <h2>Ask AI about this post</h2>
      <p>
        Ask questions based only on the content of this blog.
      </p>
    </div>

  </div>


  <!-- Toggle Button -->
  <button
    onclick="toggleChat()"
    class="ai-toggle-btn">
    💬 Chat with AI
  </button>


  <!-- Chat Dropdown -->
  <div id="chatDropdown" class="chat-dropdown">

    <div id="chatbox" class="chatbox"></div>

    <div class="chat-input-area">

      <input
        type="text"
        id="msg"
        placeholder="Ask something about this post..."
        class="chat-input"
      />

      <button
        onclick="sendMessage('<%= postId %>')"
        class="send-btn">
        Send ➤
      </button>

    </div>

  </div>

</div>
```

